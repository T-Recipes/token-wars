# Copy this file to .env and paste your Anthropic API key after the = sign.
# .env is gitignored. Never commit it, and never open it on a projected screen.
ANTHROPIC_API_KEY=

# Optional: change the local port (default 4173).
# PORT=4173

# Optional: change the "Watch my app" dashboard port (default 4174).
# WATCH_PORT=4174
